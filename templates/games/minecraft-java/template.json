{
  "$schema": "../template.schema.json",
  "id": "minecraft-java",
  "name": "Minecraft Java",
  "image": "itzg/minecraft-server:2026.11.1-java25",
  "ram": { "min": "4G", "recommended": "6G" },
  "ports": [{ "name": "game", "container": 25565, "protocol": "tcp", "default": 25565, "count": 1 }],
  "query": { "method": "minecraft", "port": "game" },
  "rcon": { "supported": true, "port": 25575, "tpsCommand": "tps" },
  "dataDir": "./data",
  "fields": [
    {
      "key": "TYPE",
      "label": "Server-Typ",
      "type": "select",
      "options": ["PAPER", "VANILLA", "FABRIC"],
      "default": "PAPER"
    },
    {
      "key": "VERSION",
      "label": "Version",
      "type": "text",
      "default": "LATEST",
      "pattern": "LATEST|SNAPSHOT|[0-9]+(\\.[0-9]+){1,2}(-[A-Za-z0-9.]+)?"
    },
    {
      "key": "MAX_PLAYERS",
      "label": "Max. Spieler",
      "type": "number",
      "default": 20,
      "min": 1,
      "max": 100
    },
    {
      "key": "MEMORY",
      "label": "RAM",
      "type": "select",
      "options": ["4G", "6G", "8G"],
      "default": "6G"
    },
    {
      "key": "SEED",
      "label": "Seed",
      "type": "text",
      "default": "",
      "optional": true,
      "pattern": "-?[A-Za-z0-9]{0,40}"
    },
    { "key": "ENABLE_WHITELIST", "label": "Whitelist", "type": "boolean", "default": true },
    {
      "key": "ONLINE_MODE",
      "label": "Online-Mode (nur echte Accounts)",
      "type": "boolean",
      "default": true
    }
  ]
}
