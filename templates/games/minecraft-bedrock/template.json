{
  "$schema": "../template.schema.json",
  "id": "minecraft-bedrock",
  "name": "Minecraft Bedrock",
  "image": "itzg/minecraft-bedrock-server:2026.11.1",
  "ram": { "min": "1G", "recommended": "2G" },
  "ports": [{ "name": "game", "container": 19132, "protocol": "udp", "default": 19132, "count": 1 }],
  "query": { "method": "minecraft-bedrock", "port": "game" },
  "rcon": { "supported": false },
  "dataDir": "./data",
  "fields": [
    {
      "key": "VERSION",
      "label": "Version",
      "type": "text",
      "default": "LATEST",
      "pattern": "LATEST|PREVIEW|[0-9]+(\\.[0-9]+){1,3}"
    },
    {
      "key": "SERVER_NAME",
      "label": "Servername",
      "type": "text",
      "default": "Homelab",
      "pattern": "[A-Za-z0-9 ._-]{1,40}"
    },
    {
      "key": "GAMEMODE",
      "label": "Spielmodus",
      "type": "select",
      "options": ["survival", "creative", "adventure"],
      "default": "survival"
    },
    {
      "key": "DIFFICULTY",
      "label": "Schwierigkeit",
      "type": "select",
      "options": ["peaceful", "easy", "normal", "hard"],
      "default": "normal"
    },
    {
      "key": "MAX_PLAYERS",
      "label": "Max. Spieler",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 50
    },
    {
      "key": "MEMORY",
      "label": "RAM",
      "type": "select",
      "options": ["1G", "2G", "4G"],
      "default": "2G"
    },
    {
      "key": "LEVEL_SEED",
      "label": "Seed",
      "type": "text",
      "default": "",
      "optional": true,
      "pattern": "-?[0-9]{0,20}"
    },
    { "key": "ALLOW_LIST", "label": "Whitelist", "type": "boolean", "default": true },
    {
      "key": "ONLINE_MODE",
      "label": "Online-Mode (nur Xbox-Konten)",
      "type": "boolean",
      "default": true
    }
  ]
}
