{
  "name": "@hz/core",
  "version": "0.0.0",
  "private": true,
  "description": "Backend: Fastify, SQLite, serves the web app",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --conditions=@hz/source --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.12",
    "@hz/shared": "workspace:*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  }
}
