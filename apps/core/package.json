{
  "name": "@hz/core",
  "version": "0.0.0",
  "private": true,
  "description": "Backend: Fastify, SQLite, serves the web app",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --conditions=@hz/source --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "@hz/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11"
  }
}
