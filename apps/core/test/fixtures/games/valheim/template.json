{
  "id": "valheim",
  "name": "Valheim",
  "image": "lloesche/valheim-server",
  "ram": { "min": "4G", "recommended": "4G" },
  "ports": [{ "name": "game", "container": 2456, "protocol": "udp", "default": 2456, "count": 3 }],
  "query": { "method": "gamedig", "port": "game", "type": "valheim" },
  "rcon": { "supported": false },
  "dataDir": "./config",
  "fields": [
    { "key": "SERVER_NAME", "label": "Servername", "type": "text", "default": "Homelab" },
    {
      "key": "SERVER_PASS",
      "label": "Passwort",
      "type": "text",
      "default": "",
      "secret": true,
      "pattern": "[A-Za-z0-9]{5,40}"
    }
  ]
}
