# syntax=docker/dockerfile:1.7
# One image: the core serves the built web app. Build context is the repo root:
#   docker compose -f deploy/docker-compose.core.yml build

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1
RUN corepack enable
WORKDIR /repo

# Build stage: full install, build, then copy only the core's production deps.
FROM base AS build
COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
RUN pnpm --filter @hz/web... --filter @hz/core... build
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
  pnpm --filter @hz/core --prod deploy --legacy /out \
  && mkdir -p /out/web \
  && cp -r apps/web/dist/. /out/web/

# Runtime stage: only the core's production deps, compiled code and the web build.
FROM node:22-bookworm-slim AS runtime
# HZ_HOST is left at the core default (127.0.0.1). Compose uses the host network,
# so the core binds the host loopback only. A bare `docker run -p` never opens it either.
ENV NODE_ENV=production \
    HZ_PORT=8080 \
    HZ_DATA_DIR=/data \
    HZ_WEB_DIR=/app/web
# The runtime never needs npm or corepack; removing them drops their dependency CVEs.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /opt/yarn* /usr/local/bin/yarn /usr/local/bin/yarnpkg
WORKDIR /app
COPY --from=build --chown=node:node /out /app
RUN mkdir -p /data && chown node:node /data
USER node
VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.HZ_PORT||8080)+'/api/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"
CMD ["node", "dist/index.js"]
