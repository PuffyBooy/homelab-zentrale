# --- Core ---
# 32 Byte als Base64, z. B.: openssl rand -base64 32
HZ_SECRET_KEY=
# Wo die SQLite-Datei liegt
HZ_DATA_DIR=./data
# Core lauscht nur lokal; nach außen nur über `tailscale serve`
HZ_HOST=127.0.0.1
HZ_PORT=8080
# Öffentliche Basis-URL im Tailnet (für Links in Push-Nachrichten)
HZ_BASE_URL=https://heimserver.DEIN-TAILNET.ts.net
# Demo-Daten für Screenshots/Tests (nie in Produktion)
HZ_DEMO=0
# Fester Setup-Token, NUR für automatisierte Tests (wird ohne NODE_ENV=test abgelehnt).
# Im Betrieb leer lassen: Der Core schreibt beim ersten Start einen einmaligen
# Setup-Link (HZ_BASE_URL/setup#token=...) ins Log.
# HZ_SETUP_TOKEN=

# --- Web-Push (VAPID). Erzeugen: pnpm --filter core vapid ---
HZ_VAPID_PUBLIC=
HZ_VAPID_PRIVATE=
HZ_VAPID_SUBJECT=mailto:admin@example.com

# --- Agent (auf jedem Server, kommt aus dem Enrollment im Core) ---
HZ_CORE_URL=wss://heimserver.DEIN-TAILNET.ts.net/agent
HZ_AGENT_TOKEN=
HZ_AGENT_NAME=heimserver
# Web-Konsole auf diesem Server erlauben (0/1)
HZ_AGENT_ALLOW_TERMINAL=0

# --- Share-Gateway (optional, nur auf dem öffentlichen Server) ---
HZ_SHARE_PUBLIC_URL=https://DEIN-DDNS-NAME
HZ_SHARE_CORE_URL=https://heimserver.DEIN-TAILNET.ts.net
HZ_SHARE_GATEWAY_TOKEN=
